# Google Apps Script web app URL for the Join Us application form.
# Deploy google-apps-script.js as a web app and paste its URL here.
# Must also be set in the Vercel project's environment variables.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Cloudinary cloud name used for logo images and the research hero clip.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dhzuwjkkz
